# ==========================================
# ITAM PRO - ENVIRONMENT VARIABLES
# ==========================================

# Mode Environment: development / production
# Jika diset ke 'production', cookie akan otomatis menggunakan secure=True
ENVIRONMENT=development

# Konfigurasi Database
# Sesuaikan user, password, host, dan nama database MySQL Anda
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/itam_db

# ==========================================
# KEAMANAN (WAJIB DIGANTI DI PRODUCTION!)
# ==========================================

# Secret Key untuk Token JWT
# Cara generate: jalankan perintah 'openssl rand -hex 32' di terminal
SECRET_KEY=ganti_dengan_secret_key_yang_panjang_dan_acak

# Vault Key untuk Enkripsi Kredensial (Fernet)
# Cara generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=ganti_dengan_kunci_fernet_base64_url_safe

# ==========================================
# AKUN SUPER ADMIN DEFAULT
# Dibuat otomatis saat instalasi pertama jika database kosong
# ==========================================
SUPERADMIN_USERNAME=admin_utama
SUPERADMIN_PASSWORD=UbahPasswordIni123!
